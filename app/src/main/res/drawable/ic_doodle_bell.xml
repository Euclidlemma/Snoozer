<?xml version="1.0" encoding="utf-8"?>
<!-- Snoozer's bell, drawn for this app: a pencil-outlined bell with a band near the rim,
     a hanging loop, the clapper and two sleepy "z"s. Fixed graphite ink (not tinted),
     because it always sits on a light backing (the yellow circle or the white card). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp" android:height="48dp"
    android:viewportWidth="48" android:viewportHeight="48">

    <!-- Body: a pale fill, then the firm outline. Slightly uneven, like a hand-drawn line. -->
    <path android:pathData="M7.6,36.4 C11.8,35.6 13.2,31.8 13.9,25.6 C14.6,19.2 16.1,10.8 24.1,10.5 C31.6,10.4 33.3,18.6 34.1,25.4 C34.8,31.6 36.1,35.4 40.5,36.3 C41.7,36.6 41.6,38.4 40.4,38.5 L7.7,38.6 C6.4,38.5 6.4,36.6 7.6,36.4 Z"
        android:fillColor="#FFFFFF" android:fillAlpha="0.55"
        android:strokeColor="#2E2B26" android:strokeWidth="2.4"
        android:strokeLineCap="round" android:strokeLineJoin="round"/>

    <!-- Faint second pass along the right side, like going over the line again. -->
    <path android:pathData="M24.7,11.2 C30.9,11.3 32.7,18.4 33.4,25.2 C34,30.2 35,33.7 37.7,35.3"
        android:fillColor="#00000000"
        android:strokeColor="#2E2B26" android:strokeAlpha="0.4" android:strokeWidth="1.1"
        android:strokeLineCap="round"/>

    <!-- Band near the rim. -->
    <path android:pathData="M12.7,32.4 C19.8,33.5 28.2,33.5 35.3,32.3"
        android:fillColor="#00000000"
        android:strokeColor="#2E2B26" android:strokeWidth="1.6" android:strokeLineCap="round"/>

    <!-- Shading stroke on the left of the dome. -->
    <path android:pathData="M19.2,14.6 C17.6,17.2 17,20.8 16.7,24.2"
        android:fillColor="#00000000"
        android:strokeColor="#2E2B26" android:strokeAlpha="0.35" android:strokeWidth="1.3"
        android:strokeLineCap="round"/>

    <!-- Hanging loop on top. -->
    <path android:pathData="M24,3.4 C25.5,3.4 26.3,5 26.2,7 C26.1,8.9 25.1,10.4 23.9,10.4 C22.7,10.4 21.8,8.9 21.8,7 C21.8,5 22.6,3.4 24,3.4 Z"
        android:fillColor="#00000000"
        android:strokeColor="#2E2B26" android:strokeWidth="1.9" android:strokeLineJoin="round"/>

    <!-- Clapper under the rim. -->
    <path android:pathData="M20.5,40.1 C20.8,44.7 27.3,44.8 27.5,40.1 Z"
        android:fillColor="#2E2B26"
        android:strokeColor="#2E2B26" android:strokeWidth="1.6"
        android:strokeLineCap="round" android:strokeLineJoin="round"/>

    <!-- Two "z"s drifting up from the bell: it's snoozing. -->
    <path android:pathData="M33.8,7.2 L36.6,7.1 L33.9,10 L36.8,9.9"
        android:fillColor="#00000000"
        android:strokeColor="#2E2B26" android:strokeWidth="1.3"
        android:strokeLineCap="round" android:strokeLineJoin="round"/>
    <path android:pathData="M38.6,1.9 L43,1.8 L38.7,6.4 L43.3,6.3"
        android:fillColor="#00000000"
        android:strokeColor="#2E2B26" android:strokeWidth="1.6"
        android:strokeLineCap="round" android:strokeLineJoin="round"/>
</vector>
