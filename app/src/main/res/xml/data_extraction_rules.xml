<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device-transfer rules. Everything is backed up (snoozers included)
     except per-device state that would be wrong after a restore:
     - onboarding.xml: whether onboarding was seen. A reinstall should show it again.
     - ringer_state.xml: the ringer mode Snoozer saved before muting, which belongs to the old
       phone's moment in time, not to the new install. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="onboarding.xml" />
        <exclude domain="sharedpref" path="ringer_state.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="onboarding.xml" />
        <exclude domain="sharedpref" path="ringer_state.xml" />
    </device-transfer>
</data-extraction-rules>
