/local.properties
# Android Studio / IntelliJ project settings are machine-specific (JDK paths,
# selected device, run configs) and get rewritten on every sync. Keep only the
# shared code style and inspection profiles so everyone formats code the same.
/.idea/*
!/.idea/codeStyles/
!/.idea/inspectionProfiles/
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties
